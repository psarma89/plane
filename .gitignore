# Ignore a personal CLAUDE.md at any depth. Keep the tracked root file, which
# is a symlink to AGENTS.md. To track a nested one, add a matching !/ rule.
CLAUDE.md
!/CLAUDE.md

build/
.react-router/

build/
.react-router/
temp/
# Anchored on purpose. Upstream ships this as a bare `scripts/`, which ignores a
# scripts directory at ANY depth, and that silently dropped two committed skill
# script directories. Every scripts/ directory in this tree is one we track, so
# the pattern earns nothing unanchored. The exception below is upstream's and is
# now redundant. It stays so that a merge from upstream applies cleanly.
/scripts/
!packages/i18n/scripts/

# i18n auto-generated types (regenerated on every build)
packages/i18n/src/types/keys.generated.ts

